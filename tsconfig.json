{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl" : "./",
    "paths": {
      "@/*": ["./*"],
      "@game/*": ["game/*"],
      "@geojson/*": ["geojson/*"],
      "@data/*": ["data/*"],
    }
  },
  "include": ["**/*.ts",],
  "exclude": ["node_modules"]
}
